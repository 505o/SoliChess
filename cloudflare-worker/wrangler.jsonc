{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "solichess-oauth",
  "main": "src/index.js",
  "compatibility_date": "2026-08-26",
  "workers_dev": true,
  "kv_namespaces": [
    {
      "binding": "OAUTH_RESULTS",
      "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"
    }
  ],
  "vars": {
    "CHESSCOM_OAUTH_REDIRECT_URI": "https://solichess-oauth.discord-qh.workers.dev/oauth/chesscom/callback",
    "CHESSCOM_OAUTH_TOKEN_AUTH_METHOD": "client_secret_post"
  }
}
