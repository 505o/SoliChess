# Required: Discord Developer Portal -> Bot token
DISCORD_TOKEN=

# Required: Discord application ID
DISCORD_CLIENT_ID=

# Recommended during development. Commands update instantly in this guild.
DISCORD_GUILD_ID=

# A descriptive User-Agent is required for responsible Chess.com PubAPI use.
CHESSCOM_USER_AGENT=ChessGateBot/0.1 (discord: your-discord-name; contact: you@example.com)

DATABASE_PATH=./data/chess-gate.db
CHECK_INTERVAL_MINUTES=360
VERIFICATION_TTL_MINUTES=30

# The callback registered in the Chess.com application is:
# http://localhost:3000/oauth/chesscom/callback
HTTP_PORT=3000
ENGINE_DEPTH=10
GAME_CHECK_INTERVAL_MINUTES=15
