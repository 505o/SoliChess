# Required: Discord Developer Portal -> Bot token
DISCORD_TOKEN=

# Required: Discord application ID
DISCORD_CLIENT_ID=

# Recommended during development. Commands update instantly in this guild.
DISCORD_GUILD_ID=

# A descriptive User-Agent is required for responsible Chess.com PubAPI use.
CHESSCOM_USER_AGENT=ChessGateBot/0.1 (discord: your-discord-name; contact: you@example.com)

# Existing SQLite file used only by the one-time migration command.
DATABASE_PATH=./data/chess-gate.db
# Neon pooled runtime URL (hostname contains -pooler).
DATABASE_URL=
# Neon direct URL, used only for schema changes and one-time migration.
DATABASE_URL_DIRECT=
DATABASE_RETENTION_DAYS=90
CHECK_INTERVAL_MINUTES=360
VERIFICATION_TTL_MINUTES=30

# Enable these together after Chess.com sends the approved OAuth endpoints/client ID.
CHESSCOM_OAUTH_CLIENT_ID=
CHESSCOM_OAUTH_AUTHORIZE_URL=
CHESSCOM_OAUTH_SCOPES=
# Exact production value: https://solichess-oauth.discord-qh.workers.dev/oauth/chesscom/callback
CHESSCOM_OAUTH_REDIRECT_URI=
# Production value: https://solichess-oauth.discord-qh.workers.dev
OAUTH_BRIDGE_URL=
# Generate a random secret of at least 32 characters and set the same value in the Worker.
OAUTH_BRIDGE_SECRET=

HTTP_PORT=3000
ENGINE_DEPTH=10
GAME_CHECK_INTERVAL_MINUTES=30
